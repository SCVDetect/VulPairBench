# VulPairBench: preserve source, documentation and small test fixtures.
# Generated results and raw dataset/chkpt material are never committed by default.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
*.log
.env
.env.*
!.env.example
.venv/
venv/
.idea/
.vscode/
models/SCVdet/sourcescripts/storage/external/samples.csv

# All outputs organized per model/run (the README files remain tracked)
Results/*/*
!Results/*/README.md
!Results/*/.gitkeep

# The only untracked payload allowed in checkpoint dirs is the local model artifact
models/*/checkpoints/*
!models/*/checkpoints/README.md
/home/cholo/Extention/VulPairBench/VulPairBench_ready_to_commit.zip

# Pretrained assets downloaded by original projects
# Keep only the bundled Joern Scala extractor source from external/;
# any subsequently downloaded archives, datasets, or tool installations stay local.
models/*/sourcescripts/storage/external/*
!models/*/sourcescripts/storage/external/get_func_graph.scala

models/*/sourcescripts/storage/cache/
models/*/sourcescripts/storage/interim/
models/*/sourcescripts/storage/processed/
models/*/sourcescripts/storage/outputs/
models/*/sourcescripts/storage/external/joern-cli/
models/*/sourcescripts/storage/external/*.csv
models/*/sourcescripts/storage/external/*.json
models/*/sourcescripts/storage/external/*.zip
models/*/sourcescripts/storage/external/*.pkl
models/*/sourcescripts/storage/external/*.pt
models/*/sourcescripts/storage/external/*.bin
models/*/sourcescripts/storage/external/*.ckpt
models/*/sourcescripts/storage/external/*.parquet
models/*/sourcescripts/storage/external/*.tar*
models/*/sourcescripts/storage/external/*.gz
models/*/sourcescripts/storage/external/*.npy
models/*/sourcescripts/storage/external/*.model
models/*/sourcescripts/storage/external/*.safetensors
models/*/sourcescripts/storage/external/*.sqlite
# LineVul - generated C/C++ samples for Cppcheck
/models/LineVul/cppcheck/data/c_files/
models/LineVul/linevul/saved_models/checkpoint-best-f1/12heads_linevul_model.bin


# LineVul - generated static-analysis outputs
/models/LineVul/cppcheck/output.txt
/models/LineVul/cppcheck/data/static_analysis_results.csv

# Raw and processed benchmark data
# manifest filenames may be committed separately after license and leakage checks
datasets/raw/*
!datasets/raw/.gitkeep
datasets/processed/*
!datasets/processed/.gitkeep
datasets/manifests/*
!datasets/manifests/.gitkeep
security_evidence/annotations/*
!security_evidence/annotations/.gitkeep
graph_analysis/*
!graph_analysis/.gitkeep

